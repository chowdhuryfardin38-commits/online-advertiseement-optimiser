# ═══════════════════════════════════════════
# .ENV — Backend Environment Configuration
# NEVER commit this file to Git!
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════

NODE_ENV=development
PORT=5000

# ── MySQL Database ──────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=advertisement_optimiser

# ── JWT Secret ──────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_64_CHARS_MINIMUM

# ── Frontend URL (for CORS) ─────────────────
# Local development:
FRONTEND_URL=http://localhost:5173
# Production (update when deployed):
# FRONTEND_URL=https://your-app.vercel.app

# ── Admin Seed Secret ───────────────────────
# Used once to create the first admin account via POST /api/admin/seed
# Remove this after the admin is created!
SEED_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SEED_SECRET
